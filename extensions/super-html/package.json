        "shortcuts": [
            {
                "message": "turn_off",
                "win": "ctrl+f",
                "mac": "cmd+z"
            },
            {
                "message": "turn_on",
                "win": "ctrl+g",
                "mac": "cmd+z"
            },
            {
                "message": "delete_node",
                "win": "ctrl+h",
                "mac": "cmd+z"
            },
            {
                "message": "open-main-scene",
                "win": "ctrl+m",
                "mac": "cmd+m"
            },
            {
                "message": "play-scene",
                "win": "ctrl+t",
                "mac": "cmd+t"
            },
            {
                "message": "pause-scene",
                "win": "ctrl+y",
                "mac": "cmd+y"
            },
            {
                "message": "stop-scene",
                "win": "ctrl+u",
                "mac": "cmd+u"
            },
            {
                "message": "build-project",
                "win": "ctrl+b",
                "mac": "cmd+b"
            }
        ]
